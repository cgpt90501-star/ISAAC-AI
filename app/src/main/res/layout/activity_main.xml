<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- WELCOME AREA -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="Welcome"
        android:textColor="#D4AF37" android:textSize="42sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="Your AI Assistant is Ready"
        android:textColor="#FFFFFF" android:textSize="16sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="Ready to assist you anytime, 24/7"
        android:textColor="#D4AF37" android:textSize="12sp" android:layout_marginTop="10dp" />

    <!-- YOU BUBBLE -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:text="You: Hello Isaac"
        android:background="#D4AF37" android:textColor="#FFFFFF"
        android:textSize="16sp" android:textStyle="bold"
        android:padding="12dp" android:layout_marginTop="15dp" />

    <!-- TASK AREA - AI LEFT + LIVING ROOM RIGHT -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="200dp"
        android:orientation="horizontal" android:layout_marginTop="10dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="#1A1A1A"
            android:orientation="vertical" android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI conversation" android:textColor="#D4AF37" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI: Welcome! I am your AI assistant created by Mutebi Isaac. How can I help you?"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12:55 AM" android:textColor="#888888" android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp">
            <ImageView android:id="@+id/isaacImage"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/isaac_living_room" android:scaleType="centerCrop" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mutebi Isaac" android:textColor="#D4AF37" android:textStyle="bold" android:padding="8dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- APPS AREA -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:text="👥 Contacts" android:textColor="#D4AF37" android:padding="10dp" android:textSize="16sp"/>
            <TextView android:text="💬 WhatsApp" android:textColor="#D4AF37" android:padding="10dp" android:textSize="16sp"/>
            <TextView android:text="🌐 Browser" android:textColor="#D4AF37" android:padding="10dp" android:textSize="16sp"/>
            <TextView android:text="📷 Instagram" android:textColor="#D4AF37" android:padding="10dp" android:textSize="16sp"/>
            <TextView android:text="📝 Notes" android:textColor="#D4AF37" android:padding="10dp" android:textSize="16sp"/>
            <TextView android:text="🎵 Music" android:textColor="#D4AF37" android:padding="10dp" android:textSize="16sp"/>
            <TextView android:text="📌 Pinterest" android:textColor="#D4AF37" android:padding="10dp" android:textSize="16sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- TYPE HERE -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <EditText android:id="@+id/typeHere" android:layout_width="0dp" android:layout_height="50dp"
            android:layout_weight="1" android:hint="Type here" android:textColorHint="#D4AF37"
            android:padding="12dp" android:textColor="#FFFFFF" android:background="#222222" />
        <TextView android:layout_width="50dp" android:layout_height="50dp" android:text="🎤"
            android:gravity="center" android:textSize="24sp" />
    </LinearLayout>

    <!-- BOTTOM NAV -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="15dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Home" android:gravity="center" android:textColor="#D4AF37" android:textSize="18sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chart" android:gravity="center" android:textColor="#D4AF37" android:textSize="18sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="History" android:gravity="center" android:textColor="#D4AF37" android:textSize="18sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Settings" android:gravity="center" android:textColor="#D4AF37" android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
